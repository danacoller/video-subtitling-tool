DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/subtitles
STORAGE_DIR=/data/videos
# For local dev without Docker, use e.g. STORAGE_DIR=/tmp/videos and mkdir -p /tmp/videos
MAX_UPLOAD_BYTES=2147483648
WHISPER_MODEL=small
WORKER_POLL_INTERVAL=3
ALLOWED_CONTENT_TYPES_RAW=video/mp4,video/quicktime,video/x-msvideo,video/x-matroska,video/webm
